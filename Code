#Distribution of true positive and false-positive recogniser calls relative to the score
library(ggplot2)
library (readxl)
data <- read_excel("distribution.xlsx")
data.scale <- (data$Dist-min(data$Dist))/(max(data$dDist)-min(data$Dist))
newData <- data.frame(data, data.scale)
newData
newData$ID<-as.factor(newData$ID)
p<-ggplot(newData, aes(x = data.scale, fill = ID)) + 
  geom_histogram(bins=40,alpha=0.3,colour="black",position="identity")+
  scale_fill_manual(values=c("red", "blue"))+
  theme_bw()+ 
  #theme(
   # panel.grid = element_blank()
 # )+
  labs(x="Score Threshold",y="Number of calls",title="Kaleidoscope Pro")+
  guides(fill = guide_legend(title = NULL))
p
p + scale_fill_manual(values=c("red", "blue"))


