#Acoustic identification of pasture-raised red junglefowl
library(MASS)
trainingset <-read.csv("trainingset.csv",header=T)
testingset<-read.csv("testingset.csv",header=T)
trainingjack <- lda(x = trainingset[, -1], grouping = trainingset[, 1], CV = TRUE)
trainingdfa <- data.frame(individual = trainingset[, 1], trainingjack$class)
trainingtab <- table(trainingdfa)
trainingtab
trainingsum <- sum(diag(prop.table(trainingtab)))
trainingsum

trainingtrain <- lda(x = trainingset[, -1], grouping = trainingset[, 1])
testingpre <- predict(trainingtrain, testingset[, -1])
testingdfa <- data.frame(type = testingset[, 1], testingpre$class)
testingtab <- table(testingdfa)
testingtab
testingsum <- sum(diag(prop.table(testingtab)))
testingsum


