#Density map of correlation coefficients of pair calls
library(dplyr)
library(ggplot2)
library(openxlsx)
library(matrixStats) 
library(tidyverse)
library(reshape2)#melt函数
do<-read.xlsx("density.xlsx");View(do)
inner <- subset(do,group=="within_individuals");View(inner)
betw <-  subset(do,group=="among_individuals");View(betw)
v<-ks.test(as.numeric(inner$correlation_coefficient),as.numeric(betw$correlation_coefficient))
v$p.value;v$statistic[[1]]
do$correlation_coefficient<- as.numeric(do$correlation_coefficient)
i<- median(inner$correlation_coefficient);i
b<- median(betw$correlation_coefficient);b
q<-ggplot(do,aes(correlation_coefficient,fill=group))+
            geom_density(adjust=1.75,alpha=0.6) +
            scale_fill_manual(values=c("lightsteelblue4","darksalmon"))+
            #scale_fill_manual(values=c("#76afda","#ffc556"))+
            geom_vline(aes(xintercept=i), colour="indianred4", linetype="dashed")+
            geom_vline(aes(xintercept=b), colour="darkslategrey", linetype="dashed")+
            xlim(-0.2,1.5) +
            ylim(0,4.5)+
            annotate("text", x=0.9*1.3, y=0.9*4.5, label= paste("D=",round(v$statistic[[1]],4),"; p=",round(v$p.value,5)))+ 
            theme(#legend.position="none",
                panel.grid.major = element_blank(),panel.grid.minor = element_blank(),
                panel.background = element_blank(),axis.line = element_line(color = "black",size=0.5),
                plot.margin=unit(c(0.5,1,0,0.5),"cm"))+
            labs(
                #title ="density_plot of correlation coefficient",
                y="density",x="Similarity of syllable") 
q
ggsave(q,filename ="density_plot of correlation coefficient in domastic.pdf",width =6.66,height = 3.54)  


