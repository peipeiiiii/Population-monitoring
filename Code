#AP cluster of pasture-raised red junglefowl
library(openxlsx)
dt<-read.xlsx("domestic.xlsx",sheet=1,rowNames=T)
df<-as.matrix(dt)
#1.Data clustering evaluation
#install.packages("factoextra")
library(factoextra)
gradient.color <- list(low = "#E7B800",  high = "blue")
res<-get_clust_tendency(df,n = 150,graph = TRUE,gradient = gradient.color)
res$hopkins_stat 
res$plot
#2.AP clustering
#install.packages("apcluster")
library(apcluster)
ap_clust <- apcluster(df,q=0.7,details=TRUE) 
plot(ap_clust) 
heatmap(ap_clust,df)
cat("affinity propogation optimal number of clusters:", length(ap_clust@clusters), "\n")
show(ap_clust) 
labels(ap_clust, type="enum")


